[configuration]
entry_symbol = "gd_kasane_library_init"
compatibility_minimum = "4.3"

[libraries]
macos.debug.arm64 = "bin/libgd_kasane.macos.template_debug.arm64.dylib"
macos.release.arm64 = "bin/libgd_kasane.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "bin/libgd_kasane.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "bin/libgd_kasane.macos.template_release.x86_64.dylib"
linux.debug.x86_64 = "bin/libgd_kasane.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/libgd_kasane.linux.template_release.x86_64.so"
linux.debug.arm64 = "bin/libgd_kasane.linux.template_debug.arm64.so"
linux.release.arm64 = "bin/libgd_kasane.linux.template_release.arm64.so"
windows.debug.x86_64 = "bin/libgd_kasane.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/libgd_kasane.windows.template_release.x86_64.dll"
windows.debug.arm64 = "bin/libgd_kasane.windows.template_debug.arm64.dll"
windows.release.arm64 = "bin/libgd_kasane.windows.template_release.arm64.dll"
