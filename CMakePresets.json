{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "All native core tests without the official SDK",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/target/cmake/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "KASANE_MOC3_CONFORMANCE": "ON",
        "PURISM_CORE_BUILD_TESTS": "ON",
        "PURISM_CORE_ABI": "v6"
      }
    },
    {
      "name": "core-asan",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/target/cmake/core-asan",
      "cacheVariables": {"KASANE_ENABLE_SANITIZERS": "ON"}
    },
    {
      "name": "memory-core",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/target/cmake/memory-core",
      "cacheVariables": {"KASANE_BUILD_PACKAGE": "OFF", "KASANE_MOC3_CONFORMANCE": "OFF", "PURISM_CORE_BUILD_TESTS": "OFF"}
    },
    {
      "name": "core-make",
      "inherits": "core-debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/target/cmake/core-make"
    }
  ],
  "buildPresets": [
    {"name": "core-debug", "configurePreset": "core-debug"},
    {"name": "core-asan", "configurePreset": "core-asan"},
    {"name": "memory-core", "configurePreset": "memory-core"},
    {"name": "core-make", "configurePreset": "core-make"}
  ],
  "testPresets": [
    {"name": "core-debug", "configurePreset": "core-debug", "output": {"outputOnFailure": true}},
    {"name": "core-asan", "configurePreset": "core-asan", "output": {"outputOnFailure": true}},
    {"name": "memory-core", "configurePreset": "memory-core", "output": {"outputOnFailure": true}},
    {"name": "core-make", "configurePreset": "core-make", "output": {"outputOnFailure": true}}
  ]
}
